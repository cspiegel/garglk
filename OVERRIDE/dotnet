#!/bin/bash

set -e

export WINEDEBUG=-all
export WINEPREFIX="$HOME/Wine/DotNet"

# Convert absolute Unix paths in arguments to Wine paths so that
# MSBuild (running under Wine) can do proper path joining.
args=()
next_is_path=false
for arg in "$@"
do
    if $next_is_path
    then
        # Argument following -o/--output: convert if absolute Unix path
        next_is_path=false
        if [[ "$arg" = /* ]]
        then
            args+=("$(winepath -w "$arg")")
        else
            args+=("$arg")
        fi
        continue
    fi

    case "$arg" in
        -o|--output)
            args+=("$arg")
            next_is_path=true
            ;;
        -p:*=/*|-P:*=/*)
            # MSBuild property with absolute Unix path value
            prefix="${arg%%=*}="
            path="${arg#*=}"
            args+=("${prefix}$(winepath -w "$path")")
            ;;
        *)
            args+=("$arg")
            ;;
    esac
done

exec wine "$HOME/Wine/DotNet/drive_c/Program Files/dotnet/dotnet.exe" "${args[@]}"
